<script>
	import "../app.css";
	import { invoke } from "@tauri-apps/api/core";
	import { open } from "@tauri-apps/plugin-dialog";
	import ControlGroup from "$lib/ControlGroup.svelte";
	import ColorPicker from "$lib/ColorPicker.svelte";
	import CheckboxControl from "$lib/CheckboxControl.svelte";
	import Button from "$lib/Button.svelte";
	import Input from "$lib/Input.svelte";
	let folderPath = $state("");
	let stepInterval = $state(1);
	let vignetteStrength = $state(2.5);
	let radiusDivisor = $state(4.0);
	let vignetteColor = $state("#000000");
	let debugMode = $state(false);

	async function handleProcessImages() {
        if (!folderPath) {
            alert("Please select a folder first");
            return;
        }

        try {
            const message = await invoke("process_images", {
                settings: {
                    folder_path: folderPath,
                    step_interval: stepInterval,
                    vignette_strength: vignetteStrength,
                    radius_divisor: radiusDivisor,
                    vignette_color: vignetteColor,
                    debug_mode: debugMode
                }
            });
            console.log(message);
            alert(message);
        } catch (error) {
            console.error("Processing error:", error);
            alert("Error processing images: " + error);
        }
    }

	function handleReset() {
	    vignetteColor = "#000000";
	}
	async function handleChooseFolder() {
	    const selected = await open({
	        directory: true,
	        multiple: false,
	        title: "Select Image Folder"
	    });
	    if (selected) {
	        folderPath = selected;
	    }
	}
</script>

<main class="container">
  <div class="header">
    <h1>Vignette Wizard</h1>
    <p class="subtitle">Image Processor</p>
  </div>

  <div class="section">
    <label class="section-label">Image Folder</label>
    <Input
      type="text"
      placeholder="Enter folder path or use button below..."
      bind:value={folderPath}
    />
    <Button variant="primary" onclick={handleChooseFolder}>Choose Folder</Button>
  </div>

  <div class="settings">
    <label class="section-label">Settings</label>

    <ControlGroup
      label="Step interval (process every Nth image):"
      bind:value={stepInterval}
      step={1}
      min={1}
    />

    <ControlGroup
      label="Vignette Strength:"
      bind:value={vignetteStrength}
      step={0.1}
      min={0}
    />

    <ControlGroup
      label="Radius Divisor (larger = smaller clear zone):"
      bind:value={radiusDivisor}
      step={0.1}
      min={0}
    />

    <ColorPicker bind:color={vignetteColor} {handleReset} />

    <CheckboxControl
      id="debug-mode"
      label="Debug Mode (green vignette + markers)"
      bind:checked={debugMode}
    />
  </div>

  <Button variant="primary" size="large" onclick={handleProcessImages}>Process Images</Button>
</main>

