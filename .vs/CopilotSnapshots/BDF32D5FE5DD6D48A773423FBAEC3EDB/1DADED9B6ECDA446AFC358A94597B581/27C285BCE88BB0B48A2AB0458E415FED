<script>
  let folderPath = $state("");
  let stepInterval = $state(1);
  let vignetteStrength = $state(2.5);
  let radiusDivisor = $state(4.0);
  let vignetteColor = $state("#000000");
  let debugMode = $state(false);

  function handleChooseFolder() {
    // Placeholder for folder selection logic
    console.log("Choose folder clicked");
  }

  function handleProcessImages() {
    // Placeholder for image processing logic
    console.log("Process images with settings:", {
      folderPath,
      stepInterval,
      vignetteStrength,
      radiusDivisor,
      vignetteColor,
      debugMode
    });
  }

  function handleReset() {
    vignetteColor = "#000000";
  }
</script>

<main class="container">
  <h1>Please input path to images</h1>

  <div class="section">
    <input
      type="text"
      placeholder="Enter folder path or use button below..."
      bind:value={folderPath}
      class="path-input"
    />
    <button class="primary-btn" onclick={handleChooseFolder}>Choose Folder</button>
  </div>

  <div class="control-group">
    <label>Step interval (process every Nth image):</label>
    <div class="control-row">
      <button class="control-btn minus" onclick={() => stepInterval = Math.max(1, stepInterval - 1)}>−</button>
      <input type="number" bind:value={stepInterval} class="value-input" />
      <button class="control-btn plus" onclick={() => stepInterval++}>+</button>
    </div>
  </div>

  <div class="control-group">
    <label>Vignette Strength:</label>
    <div class="control-row">
      <button class="control-btn minus" onclick={() => vignetteStrength = Math.max(0, vignetteStrength - 0.1)}>−</button>
      <input type="number" bind:value={vignetteStrength} step="0.1" class="value-input" />
      <button class="control-btn plus" onclick={() => vignetteStrength += 0.1}>+</button>
    </div>
  </div>

  <div class="control-group">
    <label>Radius Divisor (larger = smaller clear zone):</label>
    <div class="control-row">
      <button class="control-btn minus" onclick={() => radiusDivisor = Math.max(0, radiusDivisor - 0.1)}>−</button>
      <input type="number" bind:value={radiusDivisor} step="0.1" class="value-input" />
      <button class="control-btn plus" onclick={() => radiusDivisor += 0.1}>+</button>
    </div>
  </div>

  <div class="control-group">
    <label>Vignette Color (click to change):</label>
    <div class="color-row">
      <input type="color" bind:value={vignetteColor} class="color-picker" />
      <button class="secondary-btn" onclick={handleReset}>Reset</button>
    </div>
  </div>

  <div class="checkbox-group">
    <input type="checkbox" id="debug-mode" bind:checked={debugMode} />
    <label for="debug-mode">Debug Mode (green vignette + markers)</label>
  </div>

  <button class="primary-btn large" onclick={handleProcessImages}>Process Images</button>
</main>

