use std::time::Instant;
use serde::{Serialize};

#[derive(Clone, Serialize)]
pub struct TimingRecord {
    pub name: String,
    pub duration_ms: f64,
}

pub struct Timer {
    name: String,
    start: Instant,
}

impl Timer {
    /// Create a new timer with a name
    pub fn new(name: &str) -> Self {
        Timer {
            name: name.to_string(),
            start: Instant::now(),
        }
    }

    /// Get elapsed time and reset (useful for intermediate measurements)
    pub fn checkpoint(&mut self) -> f64 {
        let elapsed = self.start.elapsed().as_secs_f64() * 1000.0; // Convert to ms
        self.start = Instant::now();
        elapsed
    }

    /// End the timer and return the record
    pub fn end(self) -> TimingRecord {
        let duration_ms = self.start.elapsed().as_secs_f64() * 1000.0;
        TimingRecord {
            name: self.name,
            duration_ms,
        }
    }
}

pub struct TimingCollector {
    timings: Vec<TimingRecord>,
}

impl TimingCollector {
    pub fn new() -> Self {
        TimingCollector {
            timings: Vec::new(),
        }
    }

    pub fn record(&mut self, timing: TimingRecord) {
        self.timings.push(timing);
    }

    pub fn get_timings(&self) -> &[TimingRecord] {
        &self.timings
    }

    pub fn print_summary(&self) {
        println!("\n=== Timing Summary ===");
        for timing in &self.timings {
            println!("{}: {:.2}ms", timing.name, timing.duration_ms);
        }
        let total: f64 = self.timings.iter().map(|t| t.duration_ms).sum();
        println!("Total: {:.2}ms\n", total);
    }

    pub fn clear(&mut self) {
        self.timings.clear();
    }
}
