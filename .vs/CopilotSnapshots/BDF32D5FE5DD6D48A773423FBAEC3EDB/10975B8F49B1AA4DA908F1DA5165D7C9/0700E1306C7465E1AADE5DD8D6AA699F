<script>
  import Button from "./Button.svelte";
  import Input from "./Input.svelte";

  export let label = "";
  export let value = 0;
  export let step = 1;
  export let min = 0;

  function decrement() {
    value = Math.max(min, value - step);
  }

  function increment() {
    value += step;
  }
</script>

<div class="control-group">
  <label>{label}</label>
  <div class="control-row">
    <Button variant="secondary" size="small" onclick={decrement}>−</Button>
    <Input type="number" bind:value {step} {min} />
    <Button variant="secondary" size="small" onclick={increment}>+</Button>
  </div>
</div>

