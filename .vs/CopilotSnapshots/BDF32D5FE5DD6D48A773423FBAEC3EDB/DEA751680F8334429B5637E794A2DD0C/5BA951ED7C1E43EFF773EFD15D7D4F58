:root {
    font-family: Inter, Avenir, Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    color: #f6f6f6;
    background-color: #2f2f2f;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    -webkit-text-size-adjust: 100%;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 0;
}

button {
    border: none;
    font-family: inherit;
    cursor: pointer;
    transition: background-color 0.2s;
}

input {
    font-family: inherit;
    outline: none;
}

    input[type="text"],
    input[type="number"],
    input[type="color"] {
        border-radius: 8px;
        border: 1px solid #555;
        background-color: #444;
        color: #f6f6f6;
        font-size: 16px;
    }

        input[type="text"]:focus,
        input[type="number"]:focus {
            border-color: #1e88e5;
        }

    input[type="checkbox"] {
        cursor: pointer;
        accent-color: #1e88e5;
    }
