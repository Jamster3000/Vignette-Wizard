<script>
  export let label = "";
  export let value = 0;
  export let step = 1;
  export let min = 0;
  export let onChange;

  function decrement() {
    value = Math.max(min, value - step);
  }

  function increment() {
    value += step;
  }
</script>

<div class="control-group">
  <label>{label}</label>
  <div class="control-row">
    <button class="control-btn minus" onclick={decrement}>−</button>
    <input type="number" bind:value step={step.toString()} class="value-input" />
    <button class="control-btn plus" onclick={increment}>+</button>
  </div>
</div>

