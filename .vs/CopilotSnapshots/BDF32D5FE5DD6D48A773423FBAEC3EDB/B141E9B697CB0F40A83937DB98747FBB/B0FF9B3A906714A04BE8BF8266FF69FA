use image::{ImageBuffer, Rgba, RgbaImage, ImageReader, DynamicImage, Rgb};
use std::path::Path;
use std::fs;
use std::sync::Arc;
use std::sync::Mutex;
use crate::ProcessingSettings;
use crate::timing::Timer;
use serde::{Serialize};
use tauri::Emitter;
use jpeg_decoder::Decoder;

#[derive(Serialize, Clone)]
pub struct ProgressEvent {
	pub current: u32,
	pub total: u32,
	pub percentage: f32,
}

pub async fn process_images(
	settings: ProcessingSettings,
	processing_flag: Arc<Mutex<bool>>,
	window: tauri::Window,
) -> Result<String, String> {
	let overall_timer = Timer::new("TOTAL_PROCESSING");
	let path = Path::new(&settings.folder_path);

	if !path.is_dir() {
		return Err("Invalid folder path".to_string());
	}

	//Get image files
	let mut files: Vec<_> = fs::read_dir(path)
		.map_err(|e| format!("Failed to read directory: {}", e))?
		.filter_map(|entry| {
			entry.ok().and_then(|e| {
				let path = e.path();
				if path.is_file() {
					let ext = path.extension()?.to_string_lossy().to_lowercase();
					if matches!(ext.as_str(), "jpg" | "jpeg" | "png" | "bmp" | "tiff" | "tif" | "webp" | "gif") {
						return Some(path);
					}
				}
				None
			})
		})
		.collect();

	files.sort();

	//filter by step interval
	let files_to_process: Vec<_> = files
		.iter()
		.enumerate()
		.filter_map(|(i, f)| {
			if i as u32 % settings.step_interval == 0 {
				Some(f.clone())
			} else {
				None
			}
		})
		.collect();

	if files_to_process.is_empty() {
		return Err("No images found in folder".to_string());
	}

	let output_folder = if settings.debug_mode {
		path.join("processed_debug")
	} else {
		path.join("processed")
	};

	fs::create_dir_all(&output_folder)
		.map_err(|e| format!("Failed to create output folder: {}", e))?;

	let mut processed = 0;
	let mut failed = 0;
	let total = files_to_process.len() as u32;

	for (_index, img_path) in files_to_process.iter().enumerate() {
		//check if processing should stop
		let should_stop = {
			let flag = processing_flag.lock().unwrap();
			!*flag
		};

		if should_stop {
			return Ok(format!("Processing stopped. {} processed, {} failed", processed, failed));
		}

		match process_single_image(
			&img_path,
			&output_folder,
			&settings,
		) {
			Ok(_) => processed += 1,
			Err(e) => {
				eprintln!("Failed to process {}: {}", img_path.display(), e);
				failed += 1;
			}
		}

		// Emit progress event
		let current = (processed + failed) as u32;
		let percentage = (current as f32 / total as f32) * 100.0;
		let _ = window.emit("progress", ProgressEvent {
			current,
			total,
			percentage,
		});
	}

	let overall_record = overall_timer.end();
	println!("\n{}: {:.2}ms", overall_record.name, overall_record.duration_ms);

	Ok(format!("Processing complete. {} processed, {} failed", processed, failed))
}

fn process_single_image(
    img_path: &Path,
    output_folder: &Path,
    settings: &ProcessingSettings,
) -> Result<(), String> {
    let image_name = img_path.file_name().unwrap().to_string_lossy();
    let file_timer = Timer::new(&format!("file: {}", image_name));

    // Load image
    let load_timer = Timer::new("  └─ load_image");
    let img = load_image_fast(img_path)?;
    let load_record = load_timer.end();
    println!("{}: {:.2}ms", load_record.name, load_record.duration_ms);

    let rgba_img = img.to_rgba8();
    let (width, height) = rgba_img.dimensions();

    // Create mask
    let mask_timer = Timer::new("  └─ create_mask");
    let mask = create_circular_mask(
        width,
        height,
        settings.radius_divisor,
        settings.vignette_strength,
    );
    let mask_record = mask_timer.end();
    println!("{}: {:.2}ms", mask_record.name, mask_record.duration_ms);

    // Apply vignette
    let vignette_timer = Timer::new("  └─ apply_vignette");
    let color_rgb = if settings.debug_mode {
        (0, 255, 0)
    } else {
        hex_to_rgb(&settings.vignette_color).unwrap_or((0,0,0))
    };
    let result = apply_vignette(&rgba_img, &mask, color_rgb);
    let vignette_record = vignette_timer.end();
    println!("{}: {:.2}ms", vignette_record.name, vignette_record.duration_ms);

    // Save image
    let save_timer = Timer::new("  └─ save_image");
    let file_name = img_path.file_name().unwrap().to_string_lossy();
    let output_path = output_folder.join(file_name.as_ref());

    // Convert RGBA to RGB for JPEG compatibility
    let ext = output_path.extension().unwrap_or_default().to_string_lossy().to_lowercase();
    if ext == "jpg" || ext == "jpeg" {
        let rgb_image = DynamicImage::ImageRgba8(result.clone()).to_rgb8();
        rgb_image.save(&output_path)
            .map_err(|e| format!("Failed to save image: {}", e))?;
    } else {
        result.save(&output_path)
            .map_err(|e| format!("Failed to save image: {}", e))?;
    }
    let save_record = save_timer.end();
    println!("{}: {:.2}ms", save_record.name, save_record.duration_ms);

    let file_record = file_timer.end();
    println!("{}: {:.2}ms\n", file_record.name, file_record.duration_ms);

    Ok(())
}

fn load_image_fast(img_path: &Path) -> Result<DynamicImage, String> {
    let ext = img_path.extension()
        .unwrap_or_default()
        .to_string_lossy()
        .to_lowercase();

    if ext == "jpg" || ext == "jpeg" {
        // Use pure Rust JPEG decoder (no C compilation needed)
        let data = fs::read(img_path)
            .map_err(|e| format!("Failed to read file: {}", e))?;

        let mut decoder = Decoder::new(&data[..]);
        let pixels = decoder.decode()
            .map_err(|e| format!("Failed to decode JPEG: {}", e))?;

        let metadata = decoder.info()
            .ok_or("Failed to get image metadata")?;

        let width = metadata.width as u32;
        let height = metadata.height as u32;

        // Convert to RGB image
        let rgb_image = match metadata.pixel_format {
            jpeg_decoder::PixelFormat::RGB24 => {
                image::ImageBuffer::<Rgb<u8>, Vec<u8>>::from_raw(width, height, pixels)
                    .ok_or("Failed to create RGB image buffer")?
            }
            _ => return Err("Unsupported JPEG pixel format".to_string()),
        };

        Ok(DynamicImage::ImageRgb8(rgb_image))
    } else {
        // Use standard decoder for other formats
        ImageReader::open(img_path)
            .map_err(|e| format!("Failed to open image: {}", e))?
            .decode()
            .map_err(|e| format!("Failed to decode image: {}", e))
    }
}

fn create_circular_mask(
    width: u32,
    height: u32,
    radius_divisor: f32,
    vignette_strength: f32,
) -> ImageBuffer<image::Luma<u8>, Vec<u8>> {
    let mut mask = ImageBuffer::new(width, height);

    let center_x = (width as f32 - 1.0) * 0.5;
    let center_y = (height as f32 - 1.0) * 0.5;

    let diagonal = ((width as f32).powi(2) + (height as f32).powi(2)).sqrt();
    let radius = diagonal / radius_divisor;

    let corner_dist = ((center_x).powi(2) + (center_y).powi(2)).sqrt();

    // Calculate fade range
    let fade_range = if vignette_strength >= 5.0 {
        let strength_factor = ((10.0 - vignette_strength) / 5.0).max(0.05);
        (corner_dist - radius) * strength_factor
    } else {
        corner_dist - radius
    };

    let fade_range = if fade_range <= 0.0 {
        corner_dist * 0.3
    } else {
        fade_range
    };

    for y in 0..height {
        for x in 0..width {
            let dx = x as f32 - center_x;
            let dy = y as f32 - center_y;
            let dist = (dx * dx + dy * dy).sqrt();

            let mut normalized = (dist - radius) / fade_range;
            normalized = normalized.max(0.0).min(1.0);
            normalized = normalized.powf(vignette_strength);

            let value = (255.0 * (1.0 - normalized)) as u8;
            mask.put_pixel(x, y, image::Luma([value]));
        }
    }

    mask
}

fn apply_vignette(
    img: &RgbaImage,
    mask: &image::ImageBuffer<image::Luma<u8>, Vec<u8>>,
    vignette_color: (u8, u8, u8),
) -> RgbaImage {
    let (width, height) = img.dimensions();
    let mut result = RgbaImage::new(width, height);

    for y in 0..height {
        for x in 0..width {
            let original_pixel = img.get_pixel(x, y);
            let mask_value = mask.get_pixel(x, y)[0] as f32 / 255.0;

            let r = (original_pixel[0] as f32 * mask_value
                + vignette_color.0 as f32 * (1.0 - mask_value)) as u8;
            let g = (original_pixel[1] as f32 * mask_value
                + vignette_color.1 as f32 * (1.0 - mask_value)) as u8;
            let b = (original_pixel[2] as f32 * mask_value
                + vignette_color.2 as f32 * (1.0 - mask_value)) as u8;
            let a = original_pixel[3];

            result.put_pixel(x, y, Rgba([r, g, b, a]));
        }
    }

    result
}

fn hex_to_rgb(hex: &str) -> Option<(u8, u8, u8)> {
    let hex = hex.trim_start_matches('#');
    if hex.len() != 6 {
        return None;
    }

    let r = u8::from_str_radix(&hex[0..2], 16).ok()?;
    let g = u8::from_str_radix(&hex[2..4], 16).ok()?;
    let b = u8::from_str_radix(&hex[4..6], 16).ok()?;

    Some((r, g, b))
}